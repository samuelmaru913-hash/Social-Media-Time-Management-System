NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/focusguard
JWT_ACCESS_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_another_secure_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
APP_BASE_URL=http://localhost:5000
CORS_ORIGIN=
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
