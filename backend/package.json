{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run db:generate && tsx watch src/server.ts",
    "build": "npm run db:generate:postgres && tsc -p tsconfig.json",
    "build:railway": "npm run build",
    "start": "node dist/server.js",
    "postinstall": "node scripts/prisma-postgresql.cjs generate --schema prisma/postgresql/schema.prisma",
    "db:generate": "prisma generate",
    "db:generate:postgres": "node scripts/prisma-postgresql.cjs generate --schema prisma/postgresql/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "node scripts/prisma-postgresql.cjs migrate deploy --schema prisma/postgresql/schema.prisma",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.9",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
