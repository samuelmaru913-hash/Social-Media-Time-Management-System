    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  }
